<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sherdor Games Launcher"
        Width="1180"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Background="#090C0F"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="GameCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,18,18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Padding="2"
                                Background="#ED151A1F"
                                BorderBrush="#2B343C"
                                BorderThickness="2"
                                CornerRadius="12"
                                Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#C4F000"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#F21B2228"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#C4F000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="#C4F000"/>
            <Setter Property="Foreground" Value="#101500"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.12"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F20A0D10" Offset="0"/>
                    <GradientStop Color="#E510161B" Offset="0.55"/>
                    <GradientStop Color="#F5090C0F" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#EA12171B"
                    BorderBrush="#243038"
                    BorderThickness="0,0,1,0">
                <Grid Margin="22,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Border Width="176"
                                Height="72"
                                Background="#C4F000"
                                CornerRadius="7">
                            <Image Source="/sherdorgame.png"
                                   Margin="10,7"
                                   Stretch="Uniform"/>
                        </Border>
                        <TextBlock x:Name="LauncherTitleText"
                                   Width="176"
                                   Margin="2,12,0,0"
                                   Text="Sherdor Games Launcher"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,36,0,0"
                            Padding="14,12"
                            Background="#243027"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Margin="0,0,10,0" FontSize="18" Foreground="#C4F000"/>
                            <TextBlock Text="Библиотека"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Библиотека игр" FontSize="30" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Внутренние игровые сборки"
                                   Margin="0,3,0,0"
                                   Foreground="#8F9CA5"
                                   FontSize="14"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Margin="0,0,14,0"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="#1B2329"
                            CornerRadius="8">
                        <TextBlock x:Name="GameCountText"
                                   Text="0 игр"
                                   Foreground="#C4F000"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="AddGameButton"
                            Grid.Column="2"
                            Content="＋  Добавить игру"
                            Click="AddGameButton_Click"
                            VerticalAlignment="Center"
                            Style="{StaticResource AddButtonStyle}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <ListBox x:Name="GamesList"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonUp="GamesList_PreviewMouseLeftButtonUp"
                             ItemContainerStyle="{StaticResource GameCardItemStyle}">
                        <ListBox.Background>
                            <ImageBrush/>
                        </ListBox.Background>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="205" Height="270">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="188"/>
                                        <RowDefinition Height="82"/>
                                    </Grid.RowDefinitions>

                                    <Border Margin="5" Background="#252D33" CornerRadius="8">
                                        <Grid>
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0.35"/>
                                                        <GradientStop Color="#D9000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="12"
                                                       VerticalAlignment="Bottom"
                                                       TextWrapping="Wrap"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="12,6,12,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   Foreground="#9AA6AE"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Status}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#C4F000"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyLibraryPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="Библиотека пока пуста"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Нажмите «Добавить игру», чтобы создать первую запись."
                                   Margin="0,8,0,0"
                                   Foreground="#8F9CA5"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
