<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        ContentRendered="Window_ContentRendered"
        Title="Игровой лаунчер"
        Height="608"
        Width="1080"
        MinHeight="520"
        MinWidth="820"
        Background="#111820">
    <Grid>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>
        <Rectangle>
            <Rectangle.Fill>
                <ImageBrush ImageSource="/background.png"/>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="48,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="GameTitleText"
                           Text="Лаунчер для внутренних тестов игр"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Внутренний лаунчер"
                           Margin="2,4,0,0"
                           FontSize="16"
                           Foreground="#CCFFFFFF"/>
            </StackPanel>

            <Border Grid.Row="1"
                    MaxWidth="600"
                    Padding="24"
                    HorizontalAlignment="Left"
                    CornerRadius="12" Margin="313,244,0,10" Width="340">
                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="Подготовка…"
                               Margin="0,0,0,12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="16"
                               Foreground="White"/>

                    <ProgressBar x:Name="ProgressBar"
                                 Height="8"
                                 Margin="0,0,0,16"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="True"/>

                    <Button x:Name="PlayButton"
                            Content="Проверка…"
                            Click="PlayButton_Click"
                            Width="300"
                            Height="100"
                            Padding="44,18"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="23"
                            FontWeight="Bold"
                            Foreground="#FF101800"
                            IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="ButtonRoot"
                                      Background="Transparent"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform/>
                                    </Grid.RenderTransform>

                                    <Image x:Name="ButtonTexture"
                                           Source="/Button.png"
                                           Stretch="Uniform"
                                           Opacity="0.92"/>

                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Grid>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonTexture"
                                                Property="Source"
                                                Value="/Button_White.png"/>
                                        <Setter TargetName="ButtonTexture"
                                                Property="Opacity"
                                                Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonRoot"
                                                Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonRoot"
                                                Property="Opacity"
                                                Value="0.58"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="VersionText"
                               Text="Версия: —"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="#BFFFFFFF"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
